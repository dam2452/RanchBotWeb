:80 {
    root * /usr/share/caddy
    encode gzip

    handle /api* {
        reverse_proxy backend:8000
    }

    handle /auth* {
        reverse_proxy backend:8000
    }

    handle /search* {
        reverse_proxy backend:8000
    }

    handle /clips* {
        reverse_proxy backend:8000
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
