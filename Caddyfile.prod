{
    # Email dla certyfikatów SSL od Let's Encrypt
    acme_ca https://acme-v02.api.letsencrypt.org/directory
    email {$ACME_EMAIL}
}

{$YOUR_DOMAIN} {
    @api_matcher path /api/v1/*
    handle @api_matcher {
        reverse_proxy {$EXISTING_RANCHBOT_API_ADDRESS}
    }

    handle {
        root * /srv/php-app/public
        php_fastcgi php-prod:9000 {
            root /srv/php-app/public
        }

        try_files {path} /index.php?{query}
        file_server
    }

    log {
        output stdout
        format console
    }

    encode gzip zstd
}
